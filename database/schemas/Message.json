{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Message",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "description": "MongoDB ObjectId"
    },
    "name": {
      "type": "string",
      "description": "Sender or visitor name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Sender email address"
    },
    "intent": {
      "type": "string",
      "description": "Contact topic category or feedback rating"
    },
    "message": {
      "type": "string",
      "description": "Message content or visitor feedback text"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of submission"
    },
    "ip": {
      "type": "string",
      "description": "Client IP address"
    }
  },
  "required": ["name", "email", "message"]
}
